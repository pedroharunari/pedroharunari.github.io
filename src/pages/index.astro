---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Pedro E. Harunari — Statistical Physicist">

  <canvas id="canvas"></canvas>

  <div class="home-wrap">
    <div class="wrapper">
      <div class="home-grid">

        <!-- Left: hero text -->
        <div>
          <p class="hero-eyebrow fade-in">Statistical Physics · Nonequilibrium Dynamics</p>
          <h1 class="hero-name fade-in">Pedro E.<br><span class="blue">Harunari</span></h1>
          <p class="hero-bio fade-in">
            I study the stochastic dynamics of partially observed systems, leveraging thermodynamics and information-theory to understand our nonequilibrium world from the lens of experimentally-accessible observables.
          </p>
          <div class="hero-meta fade-in">
            <span class="meta-item">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z"/><circle cx="12" cy="10" r="3"/></svg>
              Marseille, France
            </span>
            <span class="meta-item">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="M22 7L12 13 2 7"/></svg>
              pedroharunari@gmail.com
            </span>
          </div>
          <div class="btn-row fade-in">
            <a href="/publications" class="btn btn-primary">View Publications</a>
            <a href="/research"     class="btn btn-ghost">Research Areas</a>
            <a href="/contact"      class="btn btn-ghost">Contact</a>
          </div>
        </div>

        <!-- Right: profile card -->
        <div class="profile-card fade-in">
          <div class="profile-photo-wrap">
            <img src="/foto_barcelona_cropped.jpg" alt="Pedro E. Harunari" class="profile-photo" />
          </div>
          <div class="profile-info">
            <div class="stat-label">Current Position</div>
            <div class="stat-text">Postdoctoral Researcher · Aix Marseille University</div>
            <div class="stat-text" style="margin-top:6px">Pierre Ronceray's group</div>
          </div>
          <div class="profile-tags">
            <div class="stat-label">Research Areas</div>
            <div class="tag-row" style="margin-top:8px">
              <span class="tag">Stochastic Thermodynamics</span>
              <span class="tag">Markov Chains</span>
              <span class="tag">Information Theory</span>
              <span class="tag">Statistical Inference</span>
            </div>
          </div>
        </div>

      </div>
    </div>
  </div>

</Layout>

<style>
  #canvas { position: fixed; inset: 0; z-index: 0; pointer-events: none; }

  .home-wrap {
    position: relative;
    z-index: 1;
    padding-top: 95px;
    min-height: 100vh;
    display: flex;
    align-items: center;
  }

  .home-grid {
    display: grid;
    grid-template-columns: 1fr 400px;
    gap: 80px;
    align-items: center;
    width: 100%;
    padding: 40px 0;
  }

  .hero-eyebrow {
    font-size: 11px;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--red);
    font-weight: 600;
    margin-bottom: 18px;
    font-family: 'Space Grotesk', sans-serif;
  }

  .hero-name {
    font-family: 'Bebas Neue', sans-serif;
    font-size: clamp(72px, 9vw, 110px);
    line-height: 1.0;
    letter-spacing: 0.04em;
    margin-bottom: 26px;
  }
  .hero-name .blue { color: var(--blue); }

  .hero-bio {
    font-size: 15px;
    color: var(--muted);
    line-height: 1.8;
    max-width: 540px;
    margin-bottom: 24px;
  }

  .hero-meta { display: flex; gap: 22px; flex-wrap: wrap; margin-bottom: 30px; }

  .meta-item {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 13px;
    color: var(--muted);
    font-family: 'Space Grotesk', sans-serif;
  }
  .meta-item svg { opacity: 0.55; flex-shrink: 0; }

  .btn-row { display: flex; gap: 12px; flex-wrap: wrap; }

  /* Profile card */
  .profile-card {
    border: 3px solid var(--border);
    background: var(--card);
    overflow: hidden;
  }

  .profile-photo-wrap {
    border-bottom: 3px solid var(--border);
    overflow: hidden;
    height: 340px;
  }
  .profile-photo {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 15%;
    display: block;
  }

  .profile-info {
    padding: 20px 22px;
    border-bottom: 3px solid var(--border);
  }
  .profile-tags {
    padding: 20px 22px;
  }

  .stat-label {
    font-size: 10px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--muted);
    font-family: 'Space Grotesk', sans-serif;
    font-weight: 600;
    margin-bottom: 6px;
  }
  .stat-text {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 14px;
    font-weight: 600;
    line-height: 1.6;
  }
  .tag-row { display: flex; flex-wrap: wrap; gap: 6px; }

  @media (max-width: 900px) {
    .home-grid { grid-template-columns: 1fr; gap: 40px; }
  }
</style>

<script is:inline>
  const canvas = document.getElementById('canvas');
  const ctx    = canvas.getContext('2d');
  const COLORS = ['#CC2200', '#0D2D9E', '#F0B000'];
  let shapes   = [];

  function resize() {
    canvas.width  = window.innerWidth;
    canvas.height = window.innerHeight;
  }

  function initShapes() {
    shapes = [];
    const defs = [
      { type: 'circle', size: 200, ci: 0, xf: 0.88, yf: 0.15 },
      { type: 'rect',   size: 120, ci: 1, xf: 0.04, yf: 0.35 },
      { type: 'circle', size: 100, ci: 2, xf: 0.93, yf: 0.60 },
      { type: 'rect',   size:  80, ci: 0, xf: 0.12, yf: 0.78 },
      { type: 'circle', size: 150, ci: 1, xf: 0.50, yf: 0.88 },
      { type: 'rect',   size:  65, ci: 2, xf: 0.70, yf: 0.22 },
    ];
    for (const d of defs) {
      shapes.push({
        x: d.xf * canvas.width, y: d.yf * canvas.height,
        size: d.size, color: COLORS[d.ci], type: d.type,
        vx: (Math.random() - 0.5) * 0.14,
        vy: (Math.random() - 0.5) * 0.14,
      });
    }
  }

  function draw() {
    ctx.clearRect(0, 0, canvas.width, canvas.height);
    for (const s of shapes) {
      s.x += s.vx; s.y += s.vy;
      if (s.x < -s.size) s.x = canvas.width  + s.size;
      if (s.x > canvas.width  + s.size) s.x = -s.size;
      if (s.y < -s.size) s.y = canvas.height + s.size;
      if (s.y > canvas.height + s.size) s.y = -s.size;
      ctx.save();
      ctx.globalAlpha = 0.06;
      ctx.fillStyle   = s.color;
      if (s.type === 'circle') {
        ctx.beginPath(); ctx.arc(s.x, s.y, s.size, 0, Math.PI * 2); ctx.fill();
      } else {
        ctx.fillRect(s.x - s.size / 2, s.y - s.size / 2, s.size, s.size);
      }
      ctx.restore();
    }
    requestAnimationFrame(draw);
  }

  resize(); initShapes(); draw();
  window.addEventListener('resize', () => { resize(); initShapes(); });
</script>
