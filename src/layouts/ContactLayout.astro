---
import Layout from './Layout.astro';
const { frontmatter } = Astro.props;
const { email = '' } = frontmatter;
---

<Layout title="Contact — Pedro E. Harunari">
  <div class="page-content">
    <div class="wrapper">
      <p class="section-label fade-in">Get in Touch</p>
      <h1 class="page-title fade-in">Contact</h1>

      <div class="contact-box fade-in">
        <div class="contact-icon">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="2" y="4" width="20" height="16" rx="2"/>
            <path d="M22 7L12 13 2 7"/>
          </svg>
        </div>
        <div>
          <div class="ci-label">Email</div>
          <div class="ci-value">
            {email}
          </div>
        </div>
      </div>

    </div>
  </div>
</Layout>

<style is:global>
  .contact-box {
    display: flex;
    align-items: center;
    gap: 20px;
    border: 3px solid var(--border);
    padding: 32px 36px;
    margin-top: 12px;
    max-width: 480px;
  }

  .contact-icon {
    width: 44px;
    height: 44px;
    border: 2px solid var(--border);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    background: var(--card);
  }
  .contact-icon svg { opacity: 0.7; }

  .ci-label {
    font-size: 10px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    font-family: 'Space Grotesk', sans-serif;
    font-weight: 700;
    color: var(--muted);
    margin-bottom: 5px;
  }
  .ci-value {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 15px;
    font-weight: 500;
  }
</style>
